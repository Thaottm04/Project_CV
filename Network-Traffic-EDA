def add_behavior_features_online(df_in: pd.DataFrame) -> pd.DataFrame:
    dfb = df_in.copy()

    src_ip = group_col if (group_col is not None and group_col in dfb.columns) else None
    dst_ip = "IPV4_DST_ADDR" if "IPV4_DST_ADDR" in dfb.columns else None
    src_port = "L4_SRC_PORT" if "L4_SRC_PORT" in dfb.columns else None
    dst_port = "L4_DST_PORT" if "L4_DST_PORT" in dfb.columns else None

    dfb["_orig_order_"] = np.arange(len(dfb), dtype=np.int64)

    time_col = pick_time_col(dfb)
    if time_col is None:
        dfb["_tmp_time_order_"] = dfb["_orig_order_"]
        time_col = "_tmp_time_order_"

    if src_ip is not None:
        dfb[src_ip] = dfb[src_ip].astype(str)
    if dst_ip is not None:
        dfb[dst_ip] = dfb[dst_ip].astype(str)

    dfb = dfb.sort_values(time_col, kind="mergesort").reset_index(drop=True)

    if "PROTOCOL" in dfb.columns and pd.api.types.is_numeric_dtype(dfb["PROTOCOL"]):
        proto = dfb["PROTOCOL"].fillna(-1).astype("int64")
        dfb["is_tcp"] = (proto == 6).astype("int8")
        dfb["is_udp"] = (proto == 17).astype("int8")
        dfb["is_icmp"] = (proto == 1).astype("int8")
        dfb["is_other_l4"] = (~proto.isin([1, 6, 17])).astype("int8")
    else:
        dfb["is_tcp"] = 0
        dfb["is_udp"] = 0
        dfb["is_icmp"] = 0
        dfb["is_other_l4"] = 0

    if dst_port is not None and dst_port in dfb.columns and pd.api.types.is_numeric_dtype(dfb[dst_port]):
        p = dfb[dst_port].fillna(-1).astype("int64")
        dfb["dst_port_privileged"] = ((p >= 0) & (p <= 1023)).astype("int8")
        dfb["dst_port_ephemeral"] = (p >= 49152).astype("int8")
        dfb["dst_port_bucket"] = np.select(
            [p < 0, (p >= 0) & (p <= 1023), (p >= 1024) & (p <= 49151), p >= 49152],
            [0, 1, 2, 3],
            default=0
        ).astype("int8")
        dfb["svc_http"] = p.isin([80]).astype("int8")
        dfb["svc_https"] = p.isin([443]).astype("int8")
        dfb["svc_dns"]  = p.isin([53]).astype("int8")
        dfb["svc_ftp"]  = p.isin([20, 21]).astype("int8")
        dfb["svc_ssh"]  = p.isin([22]).astype("int8")
        dfb["svc_smtp"] = p.isin([25]).astype("int8")
    else:
        for c in ["dst_port_privileged", "dst_port_ephemeral", "dst_port_bucket",
                  "svc_http", "svc_https", "svc_dns", "svc_ftp", "svc_ssh", "svc_smtp"]:
            dfb[c] = 0

    if src_ip is None:
        for c in ["bytes_per_pkt", "log_total_bytes", "log_flow_duration_s", "log_throughput_bps"]:
            dfb[c] = 0.0
        for c in [
            "src_flow_count", "src_unique_dst_ip", "src_unique_dst_port",
            "src_bytes_sum", "src_pkts_sum", "src_duration_mean",
            "dst_flow_count", "dst_unique_src_ip", "dst_unique_src_port",
            "src_flow_count_5m", "src_unique_dst_ip_5m", "src_unique_dst_port_5m",
            "time_bin",
        ]:
            dfb[c] = 0
        dfb = dfb.sort_values("_orig_order_", kind="mergesort").reset_index(drop=True)
        dfb = dfb.drop(columns=["_orig_order_"], errors="ignore")
        dfb = dfb.drop(columns=["_tmp_time_order_"], errors="ignore")
        return dfb

    bytes_cols = [c for c in ["IN_BYTES", "OUT_BYTES"] if c in dfb.columns and pd.api.types.is_numeric_dtype(dfb[c])]
    pkts_cols  = [c for c in ["IN_PKTS", "OUT_PKTS"] if c in dfb.columns and pd.api.types.is_numeric_dtype(dfb[c])]
    dur_col = "FLOW_DURATION_MILLISECONDS" if "FLOW_DURATION_MILLISECONDS" in dfb.columns else None

    dfb["total_bytes"] = (dfb[bytes_cols].sum(axis=1) if bytes_cols else 0.0).astype("float32")
    dfb["total_pkts"]  = (dfb[pkts_cols].sum(axis=1) if pkts_cols else 0.0).astype("float32")
    dfb["dur"] = (
        dfb[dur_col].astype("float32")
        if (dur_col is not None and dur_col in dfb.columns and pd.api.types.is_numeric_dtype(dfb[dur_col]))
        else 0.0
    )

    dur_s = (dfb["dur"].astype("float32") / 1000.0).astype("float32")
    eps = np.float32(1e-6)

    pkts = np.maximum(dfb["total_pkts"].astype("float32"), np.float32(1.0))
    dfb["bytes_per_pkt"] = (dfb["total_bytes"].astype("float32") / pkts).astype("float32")

    dfb["log_total_bytes"] = np.log1p(dfb["total_bytes"].astype("float32")).astype("float32")
    dfb["log_flow_duration_s"] = np.log1p(np.maximum(dur_s, eps)).astype("float32")

    throughput_bps = (dfb["total_bytes"].astype("float32") * np.float32(8.0)) / np.maximum(dur_s, eps)
    dfb["log_throughput_bps"] = np.log1p(np.maximum(throughput_bps, np.float32(0.0))).astype("float32")

    g = dfb.groupby(src_ip, sort=False)

    dfb["src_flow_count"] = g.cumcount().astype("int32")
    dfb["src_bytes_sum"] = g["total_bytes"].transform(lambda s: s.cumsum().shift(1)).fillna(0).astype("float32")
    dfb["src_pkts_sum"]  = g["total_pkts"].transform(lambda s: s.cumsum().shift(1)).fillna(0).astype("float32")

    dur_cum = g["dur"].transform(lambda s: s.cumsum().shift(1)).fillna(0.0)
    cnt = dfb["src_flow_count"].replace(0, np.nan).astype("float32")
    dfb["src_duration_mean"] = (dur_cum / cnt).fillna(0.0).astype("float32")

    if dst_ip is not None:
        dfb["_is_new_dstip"] = (~dfb.duplicated(subset=[src_ip, dst_ip])).astype("int8")
        dfb["src_unique_dst_ip"] = (
            dfb.groupby(src_ip, sort=False)["_is_new_dstip"]
               .transform(lambda s: s.cumsum().shift(1))
               .fillna(0).astype("int32")
        )
        dfb = dfb.drop(columns=["_is_new_dstip"])
    else:
        dfb["src_unique_dst_ip"] = 0

    if dst_port is not None and dst_port in dfb.columns:
        dfb["_is_new_dstport"] = (~dfb.duplicated(subset=[src_ip, dst_port])).astype("int8")
        dfb["src_unique_dst_port"] = (
            dfb.groupby(src_ip, sort=False)["_is_new_dstport"]
               .transform(lambda s: s.cumsum().shift(1))
               .fillna(0).astype("int32")
        )
        dfb = dfb.drop(columns=["_is_new_dstport"])
    else:
        dfb["src_unique_dst_port"] = 0

    if dst_ip is not None:
        dfb["dst_flow_count"] = dfb.groupby(dst_ip, sort=False).cumcount().astype("int32")

        dfb["_is_new_srcip_for_dst"] = (~dfb.duplicated(subset=[dst_ip, src_ip])).astype("int8")
        dfb["dst_unique_src_ip"] = (
            dfb.groupby(dst_ip, sort=False)["_is_new_srcip_for_dst"]
               .transform(lambda s: s.cumsum().shift(1))
               .fillna(0).astype("int32")
        )
        dfb = dfb.drop(columns=["_is_new_srcip_for_dst"])

        if src_port is not None and src_port in dfb.columns:
            dfb["_is_new_srcport_for_dst"] = (~dfb.duplicated(subset=[dst_ip, src_port])).astype("int8")
            dfb["dst_unique_src_port"] = (
                dfb.groupby(dst_ip, sort=False)["_is_new_srcport_for_dst"]
                   .transform(lambda s: s.cumsum().shift(1))
                   .fillna(0).astype("int32")
            )
            dfb = dfb.drop(columns=["_is_new_srcport_for_dst"])
        else:
            dfb["dst_unique_src_port"] = 0
    else:
        dfb["dst_flow_count"] = 0
        dfb["dst_unique_src_ip"] = 0
        dfb["dst_unique_src_port"] = 0

    bin_ms = TIME_BIN_MINUTES * 60 * 1000
    if USE_TIMEBIN_BEHAVIOR and time_col is not None and pd.api.types.is_numeric_dtype(dfb[time_col]):
        dfb["time_bin"] = (dfb[time_col] // bin_ms).astype("int64")

        tb = dfb.groupby([src_ip, "time_bin"], sort=False).agg(
            _cnt=("time_bin", "size"),
            _udstip=(dst_ip, "nunique") if dst_ip is not None else ("time_bin", "size"),
            _udstport=(dst_port, "nunique") if (dst_port is not None and dst_port in dfb.columns) else ("time_bin", "size"),
        ).reset_index()

        tb = tb.sort_values([src_ip, "time_bin"], kind="mergesort")
        gb = tb.groupby(src_ip, sort=False)
        tb["src_flow_count_5m"] = gb["_cnt"].shift(1).fillna(0).astype("int32")
        tb["src_unique_dst_ip_5m"] = gb["_udstip"].shift(1).fillna(0).astype("int32")
        tb["src_unique_dst_port_5m"] = gb["_udstport"].shift(1).fillna(0).astype("int32")

        tb = tb[[src_ip, "time_bin", "src_flow_count_5m", "src_unique_dst_ip_5m", "src_unique_dst_port_5m"]]
        dfb = dfb.merge(tb, on=[src_ip, "time_bin"], how="left")
        for c in ["src_flow_count_5m", "src_unique_dst_ip_5m", "src_unique_dst_port_5m"]:
            dfb[c] = dfb[c].fillna(0).astype("int32")
    else:
        dfb["time_bin"] = 0
        dfb["src_flow_count_5m"] = 0
        dfb["src_unique_dst_ip_5m"] = 0
        dfb["src_unique_dst_port_5m"] = 0

    dfb = dfb.drop(columns=["total_bytes", "total_pkts", "dur"], errors="ignore")
    dfb = dfb.drop(columns=["_tmp_time_order_"], errors="ignore")

    dfb = dfb.sort_values("_orig_order_", kind="mergesort").reset_index(drop=True)
    dfb = dfb.drop(columns=["_orig_order_"], errors="ignore")
    return dfb

# =======================
