print(" TIME_COLS       =", TIME_NUM_COLS)
print(" STUMP_PROXY_COLS=", STUMP_PROXY_COLS, f"(mode={PROXY_DROP_MODE}, enabled={DROP_STUMP_PROXY_ALWAYS})")

drop_A = set(LABEL_LIKE) | set(TTL_COLS) | set(PROXY_COLS) | set(TIME_NUM_COLS) | set(STUMP_PROXY_COLS)
