# =======================
# Run pipeline (same split indices)
# =======================
def run_pipeline(
    name: str,
    df_source: pd.DataFrame,
    feature_cols: list[str],
    train_idx: np.ndarray,
    test_idx: np.ndarray,
    split_tag: str
):
    print("\n" + "=" * 80)
    print(f"PIPELINE {name} | split={split_tag} | dataset_tag={DATASET_TAG}")
    print("=" * 80)

    df_train = df_source.iloc[train_idx].copy()
    df_test = df_source.iloc[test_idx].copy()

    y_train_bin = y_bin.iloc[train_idx].to_numpy()
    y_test_bin = y_bin.iloc[test_idx].to_numpy()
    y_train_attack = y_attack.iloc[train_idx].to_numpy()
    y_test_attack = y_attack.iloc[test_idx].to_numpy()

    if name.startswith("B_"):
        df_train = add_behavior_features_online(df_train)
        df_test = add_behavior_features_online(df_test)

        missing = [c for c in ENGINEERED_BEHAVIOR_COLS if c not in df_train.columns]
        if missing:
            raise RuntimeError(f"[B] Missing engineered cols after add_behavior_features_online: {missing}")

    X_train_view = clean_numeric_frame(df_train[feature_cols].copy())
    sample = X_train_view.sample(min(len(X_train_view), DEBUG_SAMPLE_ROWS), random_state=RANDOM_STATE)
    print("Sample NaN% (top 10):")
    nan_pct = (sample.isna().mean() * 100).sort_values(ascending=False).head(10)
    print(nan_pct.round(4))

    X_train = clean_numeric_frame(df_train[feature_cols].copy())
    X_test = clean_numeric_frame(df_test[feature_cols].copy())

    print("Train:", X_train.shape, "Test:", X_test.shape)
    print("Train label %:", (pd.Series(y_train_bin).value_counts(normalize=True) * 100).round(3).to_dict())
    print("Test  label %:", (pd.Series(y_test_bin).value_counts(normalize=True) * 100).round(3).to_dict())

    preprocessor = build_preprocessor(feature_cols)
    X_train_proc = preprocessor.fit_transform(X_train)
    X_test_proc = preprocessor.transform(X_test)

    if SAVE_AS_FLOAT32:
        X_train_proc = np.asarray(X_train_proc, dtype=np.float32)
        X_test_proc = np.asarray(X_test_proc, dtype=np.float32)

    preproc_path = ARTEFACT_DIR / f"preprocessor_{name}.joblib"
    split_path = ARTEFACT_DIR / f"splits_{name}.npz"

    joblib.dump(preprocessor, preproc_path)
    np.savez_compressed(
        split_path,
        X_train=X_train_proc,
        X_test=X_test_proc,
        y_train=np.asarray(y_train_bin),
        y_test=np.asarray(y_test_bin),
        y_train_attack=np.asarray(y_train_attack),
        y_test_attack=np.asarray(y_test_attack),
        train_idx=np.asarray(train_idx),
        test_idx=np.asarray(test_idx),
        feature_names=np.asarray(feature_cols, dtype=object),
    )

    print("Saved:", preproc_path.resolve())
    print("Saved:", split_path.resolve())

    return {
        "name": name,
        "dataset_tag": DATASET_TAG,
        "dataset_rel": str(DATASET_REL),
        "split": split_tag,
        "group_col": group_col,
        "n_features": len(feature_cols),
        "features": feature_cols,
        "preprocessor_path": str(preproc_path),
        "splits_path": str(split_path),
        "drops": {
            "ttl_cols": TTL_COLS,
            "proxy_cols": PROXY_COLS,
            "time_cols": TIME_NUM_COLS,
            "stump_proxy_cols": STUMP_PROXY_COLS,
            "stump_proxy_mode": PROXY_DROP_MODE,
            "keep_raw_ports_protocol": KEEP_RAW_PORTS_PROTOCOL,
            "b_safe_drop_src_behavior": bool(DROP_SRC_BEHAVIOR_IN_B),
            "b_safe_drop_dst_behavior": bool(DROP_DST_BEHAVIOR_IN_B),
            "dedup_across_splits": bool(DEDUP_ACROSS_SPLITS),
            "dedup_use_base_numeric": bool(DEDUP_USE_BASE_NUMERIC),
            "use_common_feature_schema": bool(USE_COMMON_FEATURE_SCHEMA and bool(schema_set)),
        },
    }

