def clean_numeric_frame(X: pd.DataFrame) -> pd.DataFrame:
    X = X.copy()
    X = X.replace([np.inf, -np.inf], np.nan)
    return X

def pick_first_existing(cols: list[str], df_full: pd.DataFrame) -> str | None:
    for c in cols:
        if c in df_full.columns:
            return c
    return None

def pick_time_col(df_full: pd.DataFrame) -> str | None:
    for c in TIME_COL_CANDIDATES:
        if c in df_full.columns and pd.api.types.is_numeric_dtype(df_full[c]):
            return c
    return None

def build_preprocessor(feature_cols: list[str]) -> ColumnTransformer:
    numeric_transformer = Pipeline(steps=[
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler()),
    ])
    return ColumnTransformer(
        transformers=[("num", numeric_transformer, feature_cols)],
        remainder="drop",
    )

def choose_group_split(
    groups: np.ndarray,
    y: np.ndarray,
    group_name: str,
    test_size: float,
    base_seed: int,
    tries: int
) -> tuple[np.ndarray, np.ndarray, str]:
    y = np.asarray(y).ravel()
    pos_all = float(np.mean(y == 1))

    best = None
    best_score = 1e9
    best_tag = ""

    for i in range(tries):
        seed = base_seed + i
        gss = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=seed)
        tr_idx, te_idx = next(gss.split(np.zeros(len(y)), y, groups))

        pos_tr = float(np.mean(y[tr_idx] == 1))
        pos_te = float(np.mean(y[te_idx] == 1))

        score = abs(pos_tr - pos_all) + abs(pos_te - pos_all)
        if score < best_score:
            best_score = score
            best = (tr_idx.astype(np.int64), te_idx.astype(np.int64))
            best_tag = f"group({group_name}) seed={seed} pos_all={pos_all:.4f} pos_tr={pos_tr:.4f} pos_te={pos_te:.4f}"

    assert best is not None
    return best[0], best[1], best_tag

def remove_cross_split_duplicates_by_hash(
    df_full: pd.DataFrame,
    train_idx: np.ndarray,
    test_idx: np.ndarray,
    cols: list[str],
) -> np.ndarray:
    if len(cols) == 0:
        return test_idx

    tr = df_full.iloc[train_idx][cols]
    te = df_full.iloc[test_idx][cols]

    tr_hash = pd.util.hash_pandas_object(tr, index=False).to_numpy(dtype=np.uint64)
    te_hash = pd.util.hash_pandas_object(te, index=False).to_numpy(dtype=np.uint64)

    tr_unique = np.unique(tr_hash)
    is_dup = np.isin(te_hash, tr_unique, assume_unique=False)

    n_dup = int(is_dup.sum())
    if n_dup > 0:
        print(f"[DEDUP] Removing {n_dup} / {len(test_idx)} test rows duplicated in train (by cols hash).")
        test_idx = test_idx[~is_dup]
    else:
        print("[DEDUP] No exact duplicate rows across splits (by cols hash).")

    return test_idx

