b_candidates = list(dict.fromkeys(numeric_all + ENGINEERED_BEHAVIOR_COLS))
drop_B = set(LABEL_LIKE) | set(TTL_COLS) | set(PROXY_COLS) | set(TIME_NUM_COLS) | set(STUMP_PROXY_COLS)
if DROP_TIME_BIN_AS_FEATURE:
