from pathlib import Path
import re

def replace_block(src: str, pattern: str, replacement: str, label: str) -> str:
    # Dùng re.S (dotall) để dấu chấm (.) bao gồm cả ký tự xuống dòng \n
    new_src, n = re.subn(pattern, replacement, src, flags=re.S)
    if n != 1:
        raise RuntimeError(f'Không thay được block {label}; số match={n}')
    return new_src

