def run_one(dataset_tag: str, pipeline: str):
    art_dir = ensure_dir(ROOT / ARTEFACTS_DIRNAME / dataset_tag / RUN_TAG)
    report_dir = ROOT / "reports" / REPORT_SUBDIR / RUN_TAG / dataset_tag / pipeline
    fig_dir = ensure_dir(report_dir / "figures")
    table_dir = ensure_dir(report_dir / "tables")
    scores_dir = ensure_dir(report_dir / "scores")

    # Load dữ liệu từ file NPZ đã được chia sẵn chuẩn xác
    X_train, X_test, y_train, y_test, feature_names = load_npz(art_dir, pipeline)
    
    if feature_names is None:
        feature_names = [f"f{i}" for i in range(X_train.shape[1])]

    # subsample for training/eval (optional)
    tr_idx = stratified_sample_idx(y_train, SUP_TRAIN_MAX, SEED + 1)
    te_idx = stratified_sample_idx(y_test, SUP_EVAL_MAX, SEED + 2)
    Xtr, ytr = X_train[tr_idx], y_train[tr_idx]
    Xte, yte = X_test[te_idx], y_test[te_idx]

    print(f"\n=== {dataset_tag} | {pipeline} | RUN_TAG={RUN_TAG} | FAST_DEV_RUN={FAST_DEV_RUN} ===")
    print("Xtr", Xtr.shape, "Xte", Xte.shape,
          "pos_tr", float(np.mean(ytr == 1)), "pos_te", float(np.mean(yte == 1)))

    dfs_scores = []
    rows_metrics: List[Dict[str, Any]] = []

    def add_score_rows(model_short: str, score: np.ndarray):
        df_temp = pd.DataFrame({
            "dataset_tag": dataset_tag,
            "pipeline": pipeline,
            "model": model_short,
            "y_true": yte.astype(int),
            "score": score.astype(float),
            "seed": int(SEED),
        })
        dfs_scores.append(df_temp)

    def maybe_plot_conf(ytrue, ypred, title, base_name: str):
        if not PLOT_FIGURES:
            return
        plot_confmat(ytrue, ypred, title, fig_dir / f"{base_name}_norm.png", normalize=True)
        plot_confmat(ytrue, ypred, title, fig_dir / f"{base_name}_counts.png", normalize=False)

    def eval_all_operating_points(model_name: str, model_short: str, score: np.ndarray):
        if model_short == "IF" and IF_THRESHOLD_AS_QUANTILE:
            thr_specs = [("q", float(q)) for q in IF_THRESHOLD_QUANTILES]
        else:
            thr_specs = [("score", float(t)) for t in THRESHOLD_LIST]

        for thr_type, thr_val in thr_specs:
            if thr_type == "q":
                thr = float(np.quantile(score, thr_val))
                thr_tag = f"q{int(round(thr_val * 1000))}"
                title = f"{model_short} ConfMat @q={thr_val} (thr={thr:.6g})"
                base = f"confmat_{model_short}_q{thr_tag}"
            else:
                thr = float(thr_val)
                thr_tag = fmt_thr_tag(thr)
                title = f"{model_short} ConfMat @thr={thr}"
                base = f"confmat_{model_short}_thr{thr_tag}"

            pred = (score >= thr).astype(int)
            m = bin_metrics(yte, pred, score)
            m.update({
                "dataset_tag": dataset_tag,
                "pipeline": pipeline,
                "model": model_name,
                "model_short": model_short,
                "mode": "threshold",
                "threshold": float(thr),
                "threshold_type": thr_type,      
                "threshold_param": float(thr_val),
                "alerts_per_1m": None,
                "k": None,
                **conf_to_dict(yte, pred),
            })
            rows_metrics.append(m)
            maybe_plot_conf(yte, pred, title, base)

        for alerts in ALERTS_PER_1M_LIST:
            alerts = int(alerts)
            do_plot = (PLOT_TOPK_ONLY_ALERTS is None) or (alerts in set(PLOT_TOPK_ONLY_ALERTS))

            pred, k = predict_topk(score, alerts)
            m = bin_metrics(yte, pred, score)

            tp = int(((yte == 1) & (pred == 1)).sum())
            pos = int((yte == 1).sum())
            m["precision_at_k"] = float(tp / max(k, 1))
            m["recall_at_k"] = float(tp / max(pos, 1))

            m.update({
                "dataset_tag": dataset_tag,
                "pipeline": pipeline,
                "model": model_name,
                "model_short": model_short,
                "mode": "topk",
                "threshold": None,
                "threshold_type": None,
                "threshold_param": None,
                "alerts_per_1m": int(alerts),
                "k": int(k),
                **conf_to_dict(yte, pred),
            })
            rows_metrics.append(m)

            if PLOT_FIGURES and do_plot:
                maybe_plot_conf(
                    yte, pred,
                    f"{model_short} ConfMat TopK alerts/1M={alerts} (K={k})",
                    f"confmat_{model_short}_topk{alerts}"
                )

            if ALSO_REPORT_THRESHOLD_AT_K:
                thrk = threshold_at_k(score, k)
                predk = (score >= thrk).astype(int)
                mk = bin_metrics(yte, predk, score)
                mk.update({
                    "dataset_tag": dataset_tag,
                    "pipeline": pipeline,
                    "model": model_name,
                    "model_short": model_short,
                    "mode": "threshold_at_k",
                    "threshold": float(thrk),
                    "threshold_type": "score",
                    "threshold_param": None,
                    "alerts_per_1m": int(alerts),
                    "k": int(k),
                    **conf_to_dict(yte, predk),
                })
                rows_metrics.append(mk)

        if PLOT_FIGURES:
            plot_roc(yte, score, f"ROC {model_short}", fig_dir / f"roc_{model_short}.png")

    # -------------------------
    # Train + score each model
    # -------------------------
    if RUN_RF:
        rf = train_rf(Xtr, ytr)
        model_out_path = art_dir / f"rf_model_{dataset_tag}_{pipeline}.pkl"
        joblib.dump(rf, model_out_path)
        score = rf.predict_proba(Xte)[:, 1]
        add_score_rows("RF", score)
        eval_all_operating_points("RandomForest(binary)", "RF", score)

        if DO_IMPORTANCE:
            imp = pd.DataFrame({
                "feature": feature_names,
                "importance": rf.feature_importances_.astype(float),
            }).sort_values("importance", ascending=False)

            imp.to_csv(table_dir / f"importance_{dataset_tag}_{pipeline}_RF_gini_all.csv",
                       index=False, encoding="utf-8-sig")
            imp.head(IMPORTANCE_TOPN).to_csv(
                table_dir / f"importance_{dataset_tag}_{pipeline}_RF_top{IMPORTANCE_TOPN}.csv",
                index=False, encoding="utf-8-sig"
            )

            if DO_PERM_IMPORTANCE:
                te_idx2 = stratified_sample_idx(yte, PERM_IMPORTANCE_N, SEED + 99)
                r = permutation_importance(
                    rf,
                    Xte[te_idx2],
                    yte[te_idx2],
                    n_repeats=5,
                    random_state=SEED,
                    n_jobs=-1
                )
                pimp = pd.DataFrame({
                    "feature": feature_names,
                    "perm_importance_mean": r.importances_mean.astype(float),
                    "perm_importance_std": r.importances_std.astype(float),
                }).sort_values("perm_importance_mean", ascending=False)

                pimp.to_csv(table_dir / f"perm_importance_{dataset_tag}_{pipeline}_RF.csv",
                            index=False, encoding="utf-8-sig")

    if RUN_XGB:
        base_score = float(np.mean(ytr == 1))
        xgb = try_make_xgb(1.0, base_score)

        if xgb is not None:
            xgb.fit(Xtr, ytr, verbose=False)
            model_out_path = art_dir / f"xgb_model_{dataset_tag}_{pipeline}.pkl"
            joblib.dump(xgb, model_out_path)
            score = xgb.predict_proba(Xte)[:, 1]
            print("XGB score quantiles:", np.quantile(score, [0, 0.01, 0.05, 0.1, 0.5, 0.9, 0.99, 1.0]))

            add_score_rows("XGB", score)
            eval_all_operating_points("XGBoost(binary)", "XGB", score)

    if RUN_IF:
        iso = train_if_benign_only(Xtr, ytr)
        
        model_out_path = art_dir / f"if_model_{dataset_tag}_{pipeline}.pkl"
        joblib.dump(iso, model_out_path)
        
        score = -iso.decision_function(Xte)  
        add_score_rows("IF", score)
        eval_all_operating_points("IsolationForest(unsupervised)", "IF", score)

    # -------------------------
    # Save scores + metrics
    # -------------------------
    if dfs_scores:
        df_scores = pd.concat(dfs_scores, ignore_index=True)
    else:
        df_scores = pd.DataFrame()
        
    df_metrics = pd.DataFrame(rows_metrics)

    out_scores = scores_dir / f"scores_{dataset_tag}_{pipeline}.csv"
    out_metrics = table_dir / f"metrics_{dataset_tag}_{pipeline}.csv"

    df_scores.to_csv(out_scores, index=False, encoding="utf-8-sig")
    df_metrics.to_csv(out_metrics, index=False, encoding="utf-8-sig")

    print("[Saved]", out_scores)
    print("[Saved]", out_metrics)

    # -------------------------
    # Ablation (RF) on subsample
    # -------------------------
    if DO_ABLATION and DO_IMPORTANCE and RUN_RF:
        print("[Ablation] RF (subsampled) ...")

        ab_tr_idx = stratified_sample_idx(ytr, ABLATION_TRAIN_MAX, SEED + 501)
        ab_te_idx = stratified_sample_idx(yte, ABLATION_EVAL_MAX, SEED + 502)

        Xtr_ab, ytr_ab = Xtr[ab_tr_idx], ytr[ab_tr_idx]
        Xte_ab, yte_ab = Xte[ab_te_idx], yte[ab_te_idx]

        rf_full = train_rf(Xtr_ab, ytr_ab)
        score_full = rf_full.predict_proba(Xte_ab)[:, 1]
        full_auc = float(roc_auc_score(yte_ab, score_full))

        groups = feature_groups(feature_names)
        imp_series = pd.Series(rf_full.feature_importances_.astype(float), index=feature_names).sort_values(ascending=False)

        ab_rows: List[Dict[str, Any]] = [{
            "ablation": "full",
            "n_drop": 0,
            "roc_auc": full_auc,
            "n_train": int(len(ytr_ab)),
            "n_eval": int(len(yte_ab)),
        }]

        for gname, gset in groups.items():
            Xtr2, Xte2, _ = drop_features_by_name(Xtr_ab, Xte_ab, feature_names, gset)
            rf2 = train_rf(Xtr2, ytr_ab)
            sc2 = rf2.predict_proba(Xte2)[:, 1]
            ab_rows.append({
                "ablation": f"drop_group:{gname}",
                "n_drop": int(len(gset)),
                "roc_auc": float(roc_auc_score(yte_ab, sc2)),
                "n_train": int(len(ytr_ab)),
                "n_eval": int(len(yte_ab)),
            })

        for n in ABLATION_TOPN_DROP:
            n = int(n)
            drop_set = set(imp_series.head(n).index.tolist())
            Xtr2, Xte2, _ = drop_features_by_name(Xtr_ab, Xte_ab, feature_names, drop_set)
            rf2 = train_rf(Xtr2, ytr_ab)
            sc2 = rf2.predict_proba(Xte2)[:, 1]
            ab_rows.append({
                "ablation": f"drop_top{n}_features",
                "n_drop": int(n),
                "roc_auc": float(roc_auc_score(yte_ab, sc2)),
                "n_train": int(len(ytr_ab)),
                "n_eval": int(len(yte_ab)),
            })

        out_ab = table_dir / f"ablation_{dataset_tag}_{pipeline}_RF.csv"
        pd.DataFrame(ab_rows).to_csv(out_ab, index=False, encoding="utf-8-sig")
        print("[Saved]", out_ab)


def main():
    for tag in DATASET_TAGS:
        for pipe in PIPELINES: 
            run_one(tag, pipe)

    print("\nDONE train_models_v2v3.py")


if __name__ == "__main__":
    main()

