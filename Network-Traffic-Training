def load_npz(art_dir: Path, pipeline: str):
    """
    Dùng lại logic đọc NPZ chuẩn của Leader để giữ nguyên GroupSplit
    """
    npz_path = art_dir / f"splits_{pipeline}.npz"
    if not npz_path.exists():
        raise FileNotFoundError(f"Missing NPZ: {npz_path}")

    z = np.load(npz_path, allow_pickle=True)
    X_train = z["X_train"]
    X_test = z["X_test"]
    y_train = z["y_train"].astype(int)
    y_test = z["y_test"].astype(int)

    feature_names = None
    if "feature_names" in z.files:
        feature_names = [str(x) for x in list(z["feature_names"])]

    return X_train, X_test, y_train, y_test, feature_names


def stratified_sample_idx(y: np.ndarray, max_n: Optional[int], seed: int) -> np.ndarray:
    n = int(len(y))
    if max_n is None or max_n <= 0 or max_n >= n:
        return np.arange(n, dtype=np.int64)

    rng = np.random.default_rng(seed)
    y = y.astype(int)

    pos_idx = np.where(y == 1)[0]
    neg_idx = np.where(y == 0)[0]

    pos_rate = float(np.mean(y == 1))
    n_pos = int(round(max_n * pos_rate))
    n_pos = max(1, min(n_pos, len(pos_idx)))
    n_neg = max_n - n_pos
    n_neg = max(1, min(n_neg, len(neg_idx)))

    take_pos = rng.choice(pos_idx, size=n_pos, replace=False) if len(pos_idx) else np.array([], dtype=np.int64)
    take_neg = rng.choice(neg_idx, size=n_neg, replace=False) if len(neg_idx) else np.array([], dtype=np.int64)

    idx = np.concatenate([take_pos, take_neg])
    rng.shuffle(idx)
    return idx.astype(np.int64)


def k_from_alerts_per_1m(n_total: int, alerts_per_1m: int) -> int:
    k = int(round((alerts_per_1m / 1_000_000) * n_total))
    return max(k, 1)


def predict_topk(score: np.ndarray, alerts_per_1m: int) -> Tuple[np.ndarray, int]:
    n = int(len(score))
    k = k_from_alerts_per_1m(n, alerts_per_1m)
    order = np.argsort(score)[::-1]
    yhat = np.zeros(n, dtype=int)
    yhat[order[:k]] = 1
    return yhat, k


def threshold_at_k(score: np.ndarray, k: int) -> float:
    n = len(score)
    k = max(1, min(int(k), int(n)))
    order = np.argsort(score)[::-1]
    thr = score[order[k - 1]]
    return float(thr)

def bin_metrics(y_true: np.ndarray, y_pred: np.ndarray, y_score: Optional[np.ndarray]) -> Dict[str, Any]:
    acc = accuracy_score(y_true, y_pred)
    bal = balanced_accuracy_score(y_true, y_pred)

    p_pos, r_pos, f1_pos, _ = precision_recall_fscore_support(
        y_true, y_pred, average="binary", pos_label=1, zero_division=0
    )
    p_m, r_m, f1_m, _ = precision_recall_fscore_support(
        y_true, y_pred, average="macro", zero_division=0
    )

    out = {
        "n_eval": int(len(y_true)),
        "pos_rate_eval": float(np.mean(y_true == 1)),
        "accuracy": float(acc),
        "balanced_accuracy": float(bal),
        "precision_pos": float(p_pos),
        "recall_pos": float(r_pos),
        "f1_pos": float(f1_pos),
        "precision_macro": float(p_m),
        "recall_macro": float(r_m),
        "f1_macro": float(f1_m),
        "pred_pos": int(y_pred.sum()),
    }

    if y_score is not None:
        try:
            out["roc_auc"] = float(roc_auc_score(y_true, y_score))
        except Exception:
            out["roc_auc"] = None
        try:
            out["pr_auc"] = float(average_precision_score(y_true, y_score))
        except Exception:
            out["pr_auc"] = None
    else:
        out["roc_auc"] = None
        out["pr_auc"] = None
    return out


def conf_to_dict(y_true, y_pred):
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0, 1]).ravel()
    return {"tn": int(tn), "fp": int(fp), "fn": int(fn), "tp": int(tp)}


def plot_confmat(y_true, y_pred, title, out_path: Path, normalize=True):
    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])
    cm_plot = cm.astype(float)

    if normalize:
        rs = cm_plot.sum(axis=1, keepdims=True)
        cm_plot = cm_plot / np.maximum(rs, 1.0)

    fig = plt.figure(figsize=(6, 5))
    ax = fig.add_subplot(111)
    im = ax.imshow(cm_plot, aspect="auto")
    ax.set_title(title + ("\n(norm by true rows)" if normalize else ""))
    ax.set_xlabel("Pred")
    ax.set_ylabel("True")
    ax.set_xticks([0, 1]); ax.set_yticks([0, 1])
    ax.set_xticklabels(["0", "1"])
    ax.set_yticklabels(["0", "1"])

    for i in range(cm_plot.shape[0]):
        for j in range(cm_plot.shape[1]):
            if normalize:
                txt = f"{cm_plot[i, j]:.4f}\n({cm[i, j]})"
            else:
                txt = f"{int(cm[i, j])}"
            ax.text(
                j, i, txt,
                ha="center", va="center",
                color="white" if cm_plot[i, j] < 0.5 else "black",
                fontsize=11, fontweight="bold"
            )

    fig.colorbar(im, ax=ax)
    fig.tight_layout()
    fig.savefig(out_path, dpi=200)
    plt.close(fig)

def plot_roc(y_true, y_score, title, out_path: Path):
    fpr, tpr, _ = roc_curve(y_true, y_score)
    fig = plt.figure(figsize=(6, 5))
    ax = fig.add_subplot(111)
    ax.plot(fpr, tpr)
    ax.set_title(title)
    ax.set_xlabel("FPR")
    ax.set_ylabel("TPR")
    fig.tight_layout()
    fig.savefig(out_path, dpi=200)
    plt.close(fig)


def drop_features_by_name(Xtr, Xte, feature_names: List[str], drop_set: set[str]):
    keep_idx = [i for i, f in enumerate(feature_names) if f not in drop_set]
    Xtr2 = Xtr[:, keep_idx]
    Xte2 = Xte[:, keep_idx]
    fn2 = [feature_names[i] for i in keep_idx]
    return Xtr2, Xte2, fn2


def feature_groups(feature_names: List[str]) -> Dict[str, set[str]]:
    fset = set(feature_names)

    def pick(pred):
        return {f for f in fset if pred(f)}

    groups = {
        "ports_proto": pick(lambda f: f in {"L4_SRC_PORT", "L4_DST_PORT", "PROTOCOL", "L7_PROTO"}
                                     or f.startswith("DNS_") or f.startswith("FTP_") or f.startswith("ICMP_")),
        "bytes_pkts": pick(lambda f: "BYTES" in f or "PKTS" in f or "THROUGHPUT" in f or "RETRANSMITTED" in f),
        "timing_iat": pick(lambda f: "IAT" in f or "DURATION" in f or "FLOW_DURATION" in f),
        "tcp_flags_win": pick(lambda f: "TCP_" in f or "FLAGS" in f or "WIN" in f),
        "behavior_semantic": pick(lambda f: f.startswith("src_") or f.startswith("dst_") or f.startswith("svc_")
                                           or f.startswith("is_") or f.startswith("log_")
                                           or f in {"bytes_per_pkt", "dst_port_bucket", "dst_port_privileged",
                                                    "dst_port_ephemeral", "time_bin"}),
    }
    return {k: v for k, v in groups.items() if len(v) > 0}


def ensure_dir(p: Path):
    p.mkdir(parents=True, exist_ok=True)
    return p


def fmt_thr_tag(thr: float) -> str:
    s = f"{thr:.6g}"
    return s.replace(".", "p")


