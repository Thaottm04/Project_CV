def train_rf(Xtr, ytr):
    rf = RandomForestClassifier(
        n_estimators=120,
        max_depth=18,
        min_samples_leaf=5,
        max_features="sqrt",
        n_jobs=2,
        random_state=int(SEED),
        class_weight="balanced_subsample",
    )
    rf.fit(Xtr, ytr)
    return rf

def try_make_xgb(scale_pos_weight: float, base_score: float):
    try:
        from xgboost import XGBClassifier
        return XGBClassifier(
            objective="binary:logistic",
            n_estimators=160,
            max_depth=3,
            learning_rate=0.05,
            subsample=0.8,
            colsample_bytree=0.8,
            reg_lambda=4.0,
            reg_alpha=1.5,
            min_child_weight=20,
            gamma=1.0,
            random_state=int(SEED),
            n_jobs=2,
            tree_method="hist",
            eval_metric="auc",
            scale_pos_weight=1.0,
            base_score=float(base_score),
            max_delta_step=1,
        )
    except Exception as e:
        print("[WARN] XGB unavailable:", repr(e))
        return None

def train_if_benign_only(Xtr, ytr):
    benign_idx = np.where(ytr == 0)[0]
    rng = np.random.default_rng(SEED + 10)
    if IF_BENIGN_FIT_MAX is not None and 0 < IF_BENIGN_FIT_MAX < len(benign_idx):
        benign_idx = rng.choice(benign_idx, size=int(IF_BENIGN_FIT_MAX), replace=False)

    contamination = float(np.mean(ytr == 1))
    contamination = min(max(contamination, 0.001), 0.4)

    iso = IsolationForest(
        n_estimators=int(IF_N_ESTIMATORS),
        contamination=float(contamination),
        random_state=int(SEED),
        n_jobs=-1,
        max_samples="auto",
    )
    iso.fit(Xtr[benign_idx])
    return iso


