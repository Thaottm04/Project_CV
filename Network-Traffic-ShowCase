# Initialize Database (Table 'alert')
def init_db():
    db = sqlite3.connect(DB_PATH)
    cursor = db.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS alert (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            src_ip TEXT,
            dst_ip TEXT,
            src_port INTEGER,
            dst_port INTEGER,
            protocol TEXT,
            if_anomaly_score REAL,
            rf_attack_prob REAL,
            xgb_attack_prob REAL,
            alert_level TEXT
        )
    """)
    db.commit()
    db.close()

