            st.markdown("**AI Model Confidence (RF vs XGB)**")
            hist_data = df[['rf_prob', 'xgb_prob']].melt(var_name='Model', value_name='Probability')
            hist_data['Model'] = hist_data['Model'].map({'rf_prob': 'Random Forest', 'xgb_prob': 'XGBoost'})

            fig_prob_hist = px.histogram(hist_data, x='Probability', color='Model', barmode='overlay',
                                    nbins=50, opacity=0.7,
                                    color_discrete_map={'Random Forest': '#3498DB', 'XGBoost': '#E74C3C'})
            
            fig_prob_hist.add_vline(x=dynamic_top_k_threshold, line_dash="dash", line_color="white", line_width=2,
                            annotation_text=f"Top-K Cutoff ({dynamic_top_k_threshold:.2f})", 
                            annotation_position="top right", annotation_font_color="white")

            fig_prob_hist.update_layout(xaxis_title="Attack Probability", yaxis_title="Number of Flows", margin=dict(l=0, r=0, t=30, b=0))
            st.plotly_chart(fig_prob_hist, use_container_width=True)

        with col_dist2:
            st.markdown("**Isolation Forest Anomaly Scores**")
            fig_if_hist = px.histogram(df, x='if_score', color='alert_level', barmode='overlay',
                                    nbins=50, opacity=0.75,
                                    color_discrete_map={'Green (Benign)': '#00CC96', 
                                                        'Yellow (Anomaly)': '#F39C12', 
                                                        'Red (Attack)': '#EF553B'},
                                    labels={'if_score': 'Anomaly Score', 'alert_level': 'Predicted Alert'})
            
            fig_if_hist.add_vline(x=if_threshold, line_dash="dash", line_color="white", line_width=2,
                            annotation_text=f"IF Threshold ({if_threshold})", 
                            annotation_position="top left", annotation_font_color="white")

            fig_if_hist.update_layout(xaxis_title="IF Anomaly Score", yaxis_title="Number of Flows", margin=dict(l=0, r=0, t=30, b=0))
            st.plotly_chart(fig_if_hist, use_container_width=True)

        # ==========================================
        # THREAT INTELLIGENCE
        # ==========================================
        st.markdown("---")
        st.subheader("Threat Intelligence: Top Attackers & Targets")
            
        col_ip1, col_ip2 = st.columns(2)
            
        with col_ip1:
            if not df_to_save.empty and 'IPV4_SRC_ADDR' in df_to_save.columns:
                top_src = df_to_save['IPV4_SRC_ADDR'].value_counts().head(10).reset_index()
                top_src.columns = ['Source IP', 'Alert Count']
                fig_src = px.bar(top_src, x='Alert Count', y='Source IP', orientation='h',
                                title="Top 10 Source IPs", text='Alert Count',
                                color='Alert Count', color_continuous_scale='Reds')
                fig_src.update_layout(yaxis={'categoryorder': 'total ascending'})
                st.plotly_chart(fig_src, use_container_width=True)
            else:
                st.info("No attacker data detected.")

        with col_ip2:
            if not df_to_save.empty and 'IPV4_DST_ADDR' in df_to_save.columns:
                top_dst = df_to_save['IPV4_DST_ADDR'].value_counts().head(10).reset_index()
                top_dst.columns = ['Destination IP', 'Alert Count']
                fig_dst = px.bar(top_dst, x='Alert Count', y='Destination IP', orientation='h',
                                title="Top 10 Destination IPs", text='Alert Count',
                                color='Alert Count', color_continuous_scale='Oranges')
                fig_dst.update_layout(yaxis={'categoryorder': 'total ascending'})
                st.plotly_chart(fig_dst, use_container_width=True)
            else:
                st.info("No victim data detected.")

        # ==========================================
        # TOP-K LOGS ANALYSIS & EVALUATION
        # ==========================================
        st.markdown("---")
        
        col_log_title, col_download = st.columns([3, 1])
        with col_log_title:
            st.subheader("Detailed Logs Analysis & Model Evaluation")
        with col_download:
            if csv_export_data is not None:
                st.download_button(
                    label="Download Alert Logs (CSV)",
                    data=csv_export_data,
                    file_name="nids_alert_report.csv",
                    mime="text/csv",
                    use_container_width=True
                )

        base_cols = ['IPV4_SRC_ADDR', 'IPV4_DST_ADDR', 'L4_DST_PORT', 'PROTOCOL']
        if 'y_true' in df.columns and df['y_true'].nunique() > 1:
            base_cols.append('y_true')
            
        extra_cols = [c for c in ['IN_BYTES', 'IN_PKTS', 'TCP_FLAGS', 'FLOW_DURATION'] if c in df.columns]
        display_cols = base_cols + extra_cols
        
        tab_red, tab_yellow, tab_green = st.tabs([f"🔴 Attacks", "🟡 Anomalies", "🟢 Benign"])
        
        # --- HÀM FORMAT CHỐNG LỖI HIỂN THỊ 4E... ---
        def format_for_display(df_target, cols):
            df_disp = df_target[cols].copy()
            for c in df_disp.columns:
                if pd.api.types.is_float_dtype(df_disp[c]):
                    df_disp[c] = df_disp[c].apply(lambda x: f"{x:.4f}" if pd.notnull(x) else x)
                elif pd.api.types.is_integer_dtype(df_disp[c]):
                    df_disp[c] = df_disp[c].apply(lambda x: f"{x:,}" if pd.notnull(x) else x)
            return df_disp

        with tab_red:
            st.markdown(f"**Sorted by highest attack probability (RF/XGB).**")
            top_k_red = df_red.sort_values(by='max_attack_prob', ascending=False)
            cols_to_show_red = display_cols + ['Suspicion (%)', 'rf_prob', 'xgb_prob', 'if_score']
            st.dataframe(format_for_display(top_k_red, cols_to_show_red), use_container_width=True)
            
        with tab_yellow:
            st.markdown("**Flows flagged by Isolation Forest (Zero-day / Unseen behaviors).** Sorted by most anomalous.")
            top_k_yellow = df_yellow.sort_values(by='if_score', ascending=True)
            cols_to_show_yellow = display_cols + ['if_score', 'Suspicion (%)', 'rf_prob', 'xgb_prob']
            st.dataframe(format_for_display(top_k_yellow, cols_to_show_yellow), use_container_width=True)
            
        with tab_green:
            st.markdown("**Safe network traffic.** Normal operations.")
            st.dataframe(format_for_display(df_green, display_cols), use_container_width=True)

