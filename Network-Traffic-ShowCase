                'alert_level': df_to_save['alert_level'].astype(str)
            })

            alert_data.insert(0, 'timestamp', pd.Timestamp.now().strftime("%Y-%m-%d %H:%M:%S"))
            csv_export_data = alert_data.to_csv(index=False).encode('utf-8')

            if 'last_processed_time' not in st.session_state:
