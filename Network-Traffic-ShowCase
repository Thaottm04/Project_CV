            else:
                st.info("No alert data.")

        # ==========================================
        # EXPLAINABLE AI (XAI)
        # ==========================================
        st.markdown("---")
        st.subheader("Model Explainability (XAI): Feature Importance")
        st.caption("*Note: Missing features from live PCAP (e.g., historical TCP windows) are securely padded. Models rely heavily on behavioral and time-based extracted features for live inference.*")
        
