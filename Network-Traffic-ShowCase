# Required for Windows environments utilizing Npcap
os.add_dll_directory(r"C:\Windows\System32") 

def extract_features_nfstream(pcap_path, output_csv):
    print(f"[INFO] Analyzing file {pcap_path} using NFStream...")
    if not os.path.exists(pcap_path):
        print(f"[ERROR] File not found: {pcap_path}")
        return

    # 1. Initialize NFStreamer
    streamer = nfstream.NFStreamer(source=pcap_path)
    df = streamer.to_pandas()

    if df.empty:
        print("[WARNING] No valid network flows found in the file.")
        return

    # 2. Base Features Mapping
    rename_map = {
        'src_ip': 'IPV4_SRC_ADDR',
        'dst_ip': 'IPV4_DST_ADDR',
        'src_port': 'L4_SRC_PORT',
        'dst_port': 'L4_DST_PORT',
        'protocol': 'PROTOCOL',
        'application_name': 'L7_PROTO',
        'src2dst_bytes': 'IN_BYTES',
        'src2dst_packets': 'IN_PKTS',
        'dst2src_bytes': 'OUT_BYTES',
        'dst2src_packets': 'OUT_PKTS',
        'bidirectional_duration_ms': 'FLOW_DURATION_MILLISECONDS',
        'src2dst_duration_ms': 'DURATION_IN',
        'dst2src_duration_ms': 'DURATION_OUT',
        'bidirectional_first_seen_ms': 'FLOW_START_MILLISECONDS',
        'bidirectional_last_seen_ms': 'FLOW_END_MILLISECONDS'
    }
    df_mapped = df.rename(columns=rename_map)

    print("[INFO] Calculating behavioral features...")

    # 3. Feature Engineering
    # Protocols & Ports
    if 'PROTOCOL' in df_mapped.columns:
        df_mapped['is_tcp'] = (df_mapped['PROTOCOL'] == 6).astype(int)
        df_mapped['is_udp'] = (df_mapped['PROTOCOL'] == 17).astype(int)
        df_mapped['is_icmp'] = (df_mapped['PROTOCOL'] == 1).astype(int)
        df_mapped['is_other_l4'] = (~df_mapped['PROTOCOL'].isin([1, 6, 17])).astype(int)

    if 'L4_DST_PORT' in df_mapped.columns:
        df_mapped['dst_port_privileged'] = (df_mapped['L4_DST_PORT'] <= 1024).astype(int)
        df_mapped['dst_port_ephemeral'] = (df_mapped['L4_DST_PORT'] >= 49152).astype(int)
        
        # Basic port bucketing
        df_mapped['dst_port_bucket'] = (df_mapped['L4_DST_PORT'] // 10000).astype(int)

        # Service Classification
        df_mapped['svc_http'] = (df_mapped['L4_DST_PORT'].isin([80, 8080])).astype(int)
        df_mapped['svc_https'] = (df_mapped['L4_DST_PORT'] == 443).astype(int)
        df_mapped['svc_dns'] = (df_mapped['L4_DST_PORT'] == 53).astype(int)
        df_mapped['svc_ftp'] = (df_mapped['L4_DST_PORT'].isin([20, 21])).astype(int)
        df_mapped['svc_ssh'] = (df_mapped['L4_DST_PORT'] == 22).astype(int)
        df_mapped['svc_smtp'] = (df_mapped['L4_DST_PORT'].isin([25, 465, 587])).astype(int)

    # Volume and Logarithmic Time Features
    df_mapped['bytes_per_pkt'] = np.where(df_mapped['IN_PKTS'] > 0, df_mapped['IN_BYTES'] / df_mapped['IN_PKTS'], 0)
    df_mapped['log_total_bytes'] = np.log1p(df_mapped['IN_BYTES'] + df_mapped.get('OUT_BYTES', 0))
    df_mapped['log_flow_duration_s'] = np.log1p(df_mapped['FLOW_DURATION_MILLISECONDS'] / 1000.0)
  
    # Calculate Throughput (Bytes per second)
    duration_sec = df_mapped['FLOW_DURATION_MILLISECONDS'] / 1000.0
    duration_sec = duration_sec.replace(0, 0.001) # Prevent division by zero
    df_mapped['log_throughput_bps'] = np.log1p((df_mapped['IN_BYTES'] * 8) / duration_sec)

    # --- IP-BASED STATISTICAL FEATURES (DOS & SCAN DETECTION) ---
    # Group by Source IP
    src_stats = df_mapped.groupby('IPV4_SRC_ADDR').agg(
        src_flow_count=('IPV4_SRC_ADDR', 'count'),
        src_unique_dst_ip=('IPV4_DST_ADDR', 'nunique'),
        src_unique_dst_port=('L4_DST_PORT', 'nunique'),
        src_bytes_sum=('IN_BYTES', 'sum'),
        src_pkts_sum=('IN_PKTS', 'sum'),
        src_duration_mean=('FLOW_DURATION_MILLISECONDS', 'mean')
    ).reset_index()

    # Group by Destination IP
    dst_stats = df_mapped.groupby('IPV4_DST_ADDR').agg(
        dst_flow_count=('IPV4_DST_ADDR', 'count'),
        dst_unique_src_ip=('IPV4_SRC_ADDR', 'nunique'),
        dst_unique_src_port=('L4_SRC_PORT', 'nunique')
    ).reset_index()

    # Merge statistical columns into the main dataframe
    df_mapped = df_mapped.merge(src_stats, on='IPV4_SRC_ADDR', how='left')
    df_mapped = df_mapped.merge(dst_stats, on='IPV4_DST_ADDR', how='left')

    # 5-minute window features - Simplified for short PCAP analysis
    # Directly assigning total metrics as demo pcaps are typically brief
    df_mapped['src_flow_count_5m'] = df_mapped['src_flow_count']
    df_mapped['src_unique_dst_ip_5m'] = df_mapped['src_unique_dst_ip']
    df_mapped['src_unique_dst_port_5m'] = df_mapped['src_unique_dst_port']

    # Save results
    df_mapped.to_csv(output_csv, index=False)
    print(f"[SUCCESS] Extracted and processed {len(df_mapped)} network flows. Results saved to: {output_csv}")

def get_latest_pcap_file(directory, pattern="*.pcapng"):
    """Finds the most recently created PCAPNG file in the specified directory."""
    list_of_files = glob.glob(os.path.join(directory, pattern))
    if not list_of_files:
        return None
    latest_file = max(list_of_files, key=os.path.getctime)
    return latest_file

if __name__ == "__main__":
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))
    
    # Define the directory containing PCAP files
    WATCH_DIR = os.path.join(BASE_DIR, "attack_demo")
    csv_out_path = os.path.join(BASE_DIR, "live_traffic.csv")
    
    # Create directory if it does not exist
    os.makedirs(WATCH_DIR, exist_ok=True)
    
    print(f"[INFO] Monitoring directory for PCAP/PCAPNG files: {WATCH_DIR}")
    print("[INFO] Press Ctrl+C to stop the program.\n")
    
    last_processed_file = ""
    last_modified_time = 0

    try:
        while True:
            # Locate all .pcap or .pcapng files in the directory
            list_of_files = glob.glob(os.path.join(WATCH_DIR, "*.pcap*"))
            
            if list_of_files:
                # Identify the most recently modified file
                latest_file = max(list_of_files, key=os.path.getmtime)
                current_modified_time = os.path.getmtime(latest_file)
                
                # Trigger if a new file appears OR an existing file is updated
                if latest_file != last_processed_file or current_modified_time != last_modified_time:
                    
                    # CRITICAL: Wait 10 seconds to allow packet sniffers (like Wireshark) to finish writing to disk
                    time.sleep(10) 
                    
                    print("\n" + "="*50)
                    print(f"[EVENT] New or updated file detected: {os.path.basename(latest_file)}")
                    print("[INFO] Starting extraction process...")
                    
                    try:
                        extract_features_nfstream(latest_file, csv_out_path)
                        # Update state to prevent reprocessing unless the file is modified again
                        last_processed_file = latest_file
                        last_modified_time = current_modified_time
                    except Exception as e:
                        print(f"[ERROR] Extraction failed: {e}")
            
            # Pause before scanning the directory again
            time.sleep(3)

    except KeyboardInterrupt:
        print("\n[INFO] Directory monitoring terminated by user.")


