if df is not None and models is not None:
    with st.spinner("Analyzing network traffic using AI... Please wait."):
        # Lấy nhãn thực tế nếu có
        if 'Label' in df.columns:
            df['y_true'] = df['Label']
        elif 'Attack' in df.columns:
            df['y_true'] = df['Attack']
        else:
            df['y_true'] = 'Unknown'
        
        # Preprocessing
        df_features = df.copy()
        cols_to_drop_live = ['Label', 'Attack', 'IPV4_SRC_ADDR', 'IPV4_DST_ADDR', 'Dataset', 'y_true']
        cols_to_drop_live = [c for c in cols_to_drop_live if c in df_features.columns]
        df_features = df_features.drop(columns=cols_to_drop_live)
        
        df_features = df_features.replace([np.inf, -np.inf], np.nan).fillna(0)
        for col in df_features.select_dtypes(include=['object']).columns:
            df_features[col] = pd.factorize(df_features[col])[0]
            
        # --- CHUẨN BỊ 2 MA TRẬN DỮ LIỆU ĐỘC LẬP ---
        # 1. Padding cho RF/XGB (68 cột)
        df_padded = pd.DataFrame(0, index=np.arange(len(df_features)), columns=expected_features)
        for col in df_features.columns:
            if col in df_padded.columns:
                df_padded[col] = df_features[col]
                
        # 2. Padding cho IF (51 cột)
        X_ready = models['PREPROCESSOR'].transform(df_padded)
        
        # --- CHẠY 3 MODEL VỚI X_ready ĐÃ ĐƯỢC TIỀN XỬ LÝ ---
        df['if_score'] = models['IF'].decision_function(X_ready) 
        df['rf_prob'] = models['RF'].predict_proba(X_ready)[:, 1] 
