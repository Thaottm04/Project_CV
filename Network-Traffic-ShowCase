            elif auto_refresh and current_mod_time != st.session_state.last_processed_time:
                should_save = True
                st.session_state.last_processed_time = current_mod_time

            if should_save:
                with sqlite3.connect(DB_PATH) as db:
                    alert_data.to_sql('alert', db, if_exists='append', index=False)
                
                EXPORT_DIR = os.path.join(BASE_DIR, "exported_alerts")
                os.makedirs(EXPORT_DIR, exist_ok=True)
                current_time = pd.Timestamp.now().strftime("%Y%m%d_%H%M%S")
                export_filename = f"attack_logs_{current_time}.csv"
                export_filepath = os.path.join(EXPORT_DIR, export_filename)
                
                alert_data.to_csv(export_filepath, index=False)
                st.toast(f"Saved {len(alert_data)} new alerts to Database.", icon="💾")

        # ==========================================
        # 4. DASHBOARD VISUALIZATION
